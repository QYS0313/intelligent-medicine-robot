# 请在百炼控制台轮换已暴露的旧 Key，再把新 Key 填到本地 .env。
DASHSCOPE_API_KEY=sk-replace-me
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 电脑端页面监听地址；8080 在部分 Windows 环境中会被系统拦截。
APP_HOST=127.0.0.1
APP_PORT=18080

# /24 是子网掩码，不属于 URL。
ROBOT_BASE_URL=http://10.24.104.54:8000
ROBOT_PICK_PATH=/pick-batch
ROBOT_DISABLE_PATH=/disable
ROBOT_TIMEOUT_SECONDS=240
ROBOT_VISUAL_TIMEOUT_SECONDS=5

# 比赛演示模式始终真实调用 ROBOT_BASE_URL/ROBOT_PICK_PATH，没有仿真开关。
MAX_ITEMS_PER_PLAN=4
PLAN_TTL_SECONDS=600
